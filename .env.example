# Pick ONE auth method.

# A — Google AI Studio (local / cheapest to start)
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# B — Vertex AI (billed GCP project)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

PORT=8080
# Local file is fine. Cloud Run must use /tmp (container FS is read-only).
SESSION_DB_URI=sqlite+aiosqlite:///./sessions.db

# Optional. Live lot intel via Parallel Search (fire, weather, permits).
# Analyze still runs from the lot table if this is empty.
PARALLEL_API_KEY=

# Cheapest Gemini that still tools-calls reliably
MATRIX_MODEL=gemini-2.5-flash-lite
